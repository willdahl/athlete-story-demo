{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm test",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": { "api/index.mjs": { "maxDuration": 300 } },
  "redirects": [
    { "source": "/overview", "destination": "/overview/", "permanent": true },
    { "source": "/promo", "destination": "/overview/", "permanent": false },
    { "source": "/promo/:path(.*)", "destination": "/overview/:path", "permanent": false }
  ],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?route=:path*" }]
}
