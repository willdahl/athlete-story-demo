de_id": "athlete-01-prep-20260627-01", "week_index": 19, "local_date": "2026-06-27", "distance_tenths_mile": 623, "moving_duration_seconds": 14400, "elapsed_duration_seconds": 16140, "ride_type": "steady", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}, {"ride_id": "athlete-01-prep-20260629-01", "week_index": 19, "local_date": "2026-06-29", "distance_tenths_mile": 186, "moving_duration_seconds": 5040, "elapsed_duration_seconds": 5580, "ride_type": "easy", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}, {"ride_id": "athlete-01-prep-20260630-01", "week_index": 19, "local_date": "2026-06-30", "distance_tenths_mile": 278, "moving_duration_seconds": 6240, "elapsed_duration_seconds": 6420, "ride_type": "steady", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}, {"ride_id": "athlete-01-prep-20260702-01", "week_index": 19, "local_date": "2026-07-02", "distance_tenths_mile": 205, "moving_duration_seconds": 4560, "elapsed_duration_seconds": 4800, "ride_type": "steady", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}, {"ride_id": "athlete-01-prep-20260704-01", "week_index": 20, "local_date": "2026-07-04", "distance_tenths_mile": 304, "moving_duration_seconds": 7980, "elapsed_duration_seconds": 10140, "ride_type": "easy", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}, {"ride_id": "athlete-01-prep-20260706-01", "week_index": 20, "local_date": "2026-07-06", "distance_tenths_mile": 142, "moving_duration_seconds": 3660, "elapsed_duration_seconds": 3840, "ride_type": "easy", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}, {"ride_id": "athlete-01-prep-20260708-01", "week_index": 20, "local_date": "2026-07-08", "distance_tenths_mile": 181, "moving_duration_seconds": 4620, "elapsed_duration_seconds": 4860, "ride_type": "easy", "phase": "taper", "reported_effort_0_to_10": null, "elevation_gain_meters": null}], "roleplay": {"overview": {"title": "Back in the saddle, with your friends behind you", "passages": []}, "beats": [{"id": "prep", "nav_label": "Preparation", "title": "Making time for it", "eyebrow": "WEEKS OF PREPARATION", "photo": "v2-training", "reflection": false}, {"id": "rack", "nav_label": "Pre-game", "title": "Accepting their help", "eyebrow": "THE DAY BEFORE", "photo": "v2-pregame", "reflection": false}, {"id": "start", "nav_label": "Starting alone", "title": "Doing this on my own", "eyebrow": "SEATTLE · EARLY MORNING", "photo": "v2-start", "reflection": false}, {"id": "effort", "nav_label": "Finding a rhythm", "title": "What kept me going", "eyebrow": "ON THE ROAD", "photo": "seq-photo-04", "reflection": false}, {"id": "challenge", "nav_label": "Feeling the miles", "title": "Knowing they had my back", "eyebrow": "A PAUSE · THEN BACK ON THE BIKE", "photo": "seq-photo-05", "reflection": false}, {"id": "approach", "nav_label": "Finish in sight", "title": "The finish was in sight", "eyebrow": "COMING TOWARD PORTLAND", "photo": "seq-photo-07", "reflection": false}, {"id": "finish", "nav_label": "The finish", "title": "They were there for me", "eyebrow": "THE FIRST WELCOME LIKE THIS", "photo": "seq-photo-10", "reflection": false}, {"id": "pizza", "nav_label": "Celebration", "title": "Accomplished, tired, supported", "eyebrow": "FINALLY TOGETHER", "photo": "seq-photo-11", "reflection": false}, {"id": "return-dinner", "nav_label": "Ride home together", "title": "Still together", "eyebrow": "THE WAY HOME", "photo": "seq-photo-12", "reflection": false}, {"id": "reflection", "nav_label": "What stays", "title": "What I carry with me", "eyebrow": "LOOKING BACK", "photo": "seq-photo-10", "reflection": true}], "direct": {"items": {"overview": {"title": "Back in the saddle, with your friends behind you", "paragraphs": ["You trained hard after time away from riding, and finished something you wanted to accomplish.", "This time, your friends were waiting at the finish. It was the first time anyone had been there to cheer you in."]}, "prep": {"title": "Getting back in the saddle", "paragraphs": ["You were hard on yourself about the gap in your training, even as you encouraged yourself and felt happy to be riding again.", "Then, on a ride where you were tracking distance and elevation, you felt you were back. Your speed and endurance were getting closer to what they had been.", "Early mornings on weekends. Afternoons or your trainer at home during the week. You remember training on 75 days, with breaks in between."]}, "rack": {"title": "Glad they were coming, reluctant to accept help", "paragraphs": ["You had planned to manage the ride and get home yourself, with family commitments early on Sunday. The day before, you met your friends and transferred your bike rack to their car. They were coming to Portland to support you.", "You were glad, but it felt like a lot of effort just for you. Knowing they wanted the Portland trip too let you off the hook a little. You appreciated the offer and were still reluctant to accept help."]}, "start": {"title": "Your pace, on your own", "paragraphs": ["You were excited and nervous. A long, hard ride was ahead, and you were going alone.", "This time you could ride at your own pace. You had slowed down for other people on previous rides. Now there would be no one holding you back, but no companion beside you if something went wrong or you needed encouragement."]}, "effort": {"title": "Seeing what you could do", "paragraphs": ["You wanted to see what you could do and what you were made of. When it got hard, you kept your goal, your music, and the feeling of accomplishment in mind. You thought about the work you had put in."]}, "challenge": {"title": "Feeling the miles, knowing they had your back", "paragraphs": ["The miles were getting to you. When you told your friends you were feeling under the weather, they immediately asked if you were okay and offered to pick you up. They also encouraged you in what you had done and could do.", "You felt supported. You took a moment to reflect and got back on the bike, knowing they had your back and would be waiting for you."]}, "approach": {"title": "The finish coming into sight", "paragraphs": ["The later miles were still tough. Some stretches felt dangerous, and you did your best to stay focused and alert.", "Then you could see the mountain and skyline. The finish felt close."]}, "finish": {"title": "Your friends were waiting for you at the finish", "paragraphs": ["For the first time, people were waiting for you at the finish. They had followed your progress so they could be there to cheer and record you coming in. That effort was what made it special to you.", "Watching the recording afterward, you were glad to have evidence of what you had accomplished, and that others had helped make that memory possible."]}, "pizza": {"title": "Accomplished, tired, and supported", "paragraphs": ["You hugged your friends and celebrated, then went to the beer garden to relax and eat together. You felt accomplished, tired, and supported."]}, "return-dinner": {"title": "The ride home together", "paragraphs": ["You rode home together, stopping for a late dinner on the way. You remember everyone being tired in their own ways, but happy to have shared the experience.", "You talked about the ride, the preparation, and what was next. Then you were just chilling and hanging out."]}, "reflection": {"title": "Paying the friendship forward", "paragraphs": ["You had imagined yourself as the independent hero. You accomplished what you wanted, and came through knowing that friends and friends of friends would show up for you.", "You want to pay that forward. You are still discovering what that might look like.", "What matters most to keep is that this happened, and that you can carry it with you."]}}}}}